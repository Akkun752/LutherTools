// Generated by CMake (configure_file) from the VERSION declared in
// CMakeLists.txt's project(). Embeds the version number into the
// executable's Windows properties (right-click LutherTools.exe >
// Properties > Details). Do not edit directly: change the version in
// CMakeLists.txt instead (and the fields below if needed, just once).
#include <windows.h>

// Executable icon: unlike QWindow::setWindowIcon() (which only decorates
// the window once the app has launched), this ICON resource is what gives
// the .exe file itself its icon in Explorer and, above all, in the Windows
// taskbar from the moment it launches (even before Qt has taken over). The
// first ICON in the .rc file becomes the executable's default icon.
IDI_ICON1 ICON "@LUTHERTOOLS_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "FlitStudio"
            VALUE "FileDescription", "LutherTools"
            VALUE "FileVersion", "@PROJECT_VERSION@.0"
            VALUE "InternalName", "LutherTools"
            VALUE "OriginalFilename", "LutherTools.exe"
            VALUE "ProductName", "LutherTools"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
