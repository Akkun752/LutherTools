// Généré par CMake (configure_file) à partir de la VERSION déclarée dans
// project() de CMakeLists.txt. Embarque le numéro de version dans les
// propriétés Windows de l'exécutable (clic droit sur LutherTools.exe >
// Propriétés > Détails). Ne pas éditer directement : modifie la version
// dans CMakeLists.txt (et les champs ci-dessous si besoin, une seule fois).
#include <windows.h>

// Icône de l'exécutable : contrairement à QWindow::setWindowIcon() (qui ne
// fait qu'illustrer la fenêtre une fois l'appli lancée), c'est cette
// ressource ICON qui donne son icône au fichier .exe lui-même dans
// l'Explorateur et, surtout, à la barre des tâches Windows dès le lancement
// (avant même que Qt n'ait eu la main). Le premier ICON du fichier .rc
// devient l'icône par défaut de l'exécutable.
IDI_ICON1 ICON "@LUTHERTOOLS_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040c04b0"
        BEGIN
            VALUE "CompanyName", "FlitStudio"
            VALUE "FileDescription", "LutherTools"
            VALUE "FileVersion", "@PROJECT_VERSION@.0"
            VALUE "InternalName", "LutherTools"
            VALUE "OriginalFilename", "LutherTools.exe"
            VALUE "ProductName", "LutherTools"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x040c, 1200
    END
END
